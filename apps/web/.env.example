# API 基地址（默认指向本地 Prism mock）
NEXT_PUBLIC_API_BASE=http://localhost:4010

# 社区链接（未配置的渠道在页脚中隐藏）
# 可选构建期兜底；优先读取后台 GET /site/social（x/telegram/facebook/discord/instagram/youtube/tiktok/reddit/medium）。
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_TELEGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_DISCORD=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
# Support panel contacts (unset = hidden)
NEXT_PUBLIC_SUPPORT_URL=
NEXT_PUBLIC_SUPPORT_TELEGRAM=
NEXT_PUBLIC_SUPPORT_EMAIL=

# Server-only (runtime, not NEXT_PUBLIC): /gw proxy target. Prefer the internal
# gateway (http://gateway:8080) over API_PROXY_TARGET; GATEWAY_EDGE_SECRET must
# match the gateway's so it trusts the forwarded client IP/country.
# GATEWAY_INTERNAL_URL=http://localhost:8080
# GATEWAY_EDGE_SECRET=
# GATEWAY_PROXY_TIMEOUT_MS=15000
