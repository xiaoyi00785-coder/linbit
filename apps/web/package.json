{
  "name": "@linbit/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/gen-asset-manifest.mjs",
    "dev": "next dev -p 3000",
    "prebuild": "sh ../../scripts/check-web-no-demo.sh && node scripts/gen-asset-manifest.mjs",
    "build": "next build",
    "start": "next start -p 3000",
    "pretypecheck": "node scripts/gen-asset-manifest.mjs",
    "typecheck": "tsc --noEmit",
    "check:order-display": "node --experimental-strip-types scripts/check-order-display.mjs",
    "check:redirect": "node --experimental-strip-types scripts/check-safe-redirect.mjs",
    "check:nav": "node scripts/check-nav-dropdowns.mjs",
    "check:live-ticks": "node --experimental-strip-types scripts/check-live-ticks.mjs",
    "check:gw-proxy": "node --experimental-strip-types scripts/check-gw-proxy.mjs",
    "check:partner-url": "node --experimental-strip-types scripts/check-partner-url.mjs",
    "check:no-demo": "sh ../../scripts/check-web-no-demo.sh"
  },
  "dependencies": {
    "@linbit/api-client": "workspace:*",
    "@linbit/chart": "workspace:*",
    "@linbit/ui": "workspace:*",
    "@tanstack/react-query": "^5.59.16",
    "lightweight-charts": "^4.2.3",
    "next": "14.2.15",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.16.13",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "playwright": "1.64.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
}
