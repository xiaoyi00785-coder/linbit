.gradle/
build/
local.properties
*.iml
.idea/
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
# 签名材料永不入库
*.jks
*.keystore
keystore.properties
# gradle-wrapper.jar / gradlew / gradlew.bat 入库（评审认可的「禁止二进制」例外；wrapper 由 CI 的 wrapper-validation 校验）

# 仓库根 .gitignore 有 `data/`（忽略数据目录），这里的 data 是 Kotlin 包（行情仓库），需要显式放行
!app/src/main/kotlin/click/cowa/linbit/data/
app/shots.gradle.kts
# 离屏截图输出（可复现测试生成，不入库）
app/build/reports/offscreen-shots/
**/offscreen-shots/
app/shots.gradle.kts

# Targeted source exception only. Other ignored data/ trees stay untouched.
!app/src/test/kotlin/click/cowa/linbit/data/
!app/src/test/kotlin/click/cowa/linbit/data/paper/
!app/src/test/kotlin/click/cowa/linbit/data/paper/PaperTradingContractTest.kt
