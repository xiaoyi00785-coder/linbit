# Linbit 主网环境变量模板 —— 只放占位符，严禁提交真实值。
# 复制到服务器运维 .env（沿用当前服务器与域名），密钥只由运维写入，绝不通过聊天传递。标注 [必填] 的缺失时服务启动即失败（preflight）。

# ---- 网络总开关 ----
NETWORK=mainnet                 # [必填] 唯一开关；与 APP_ENV 冲突则拒绝启动
APP_ENV=mainnet
LINBIT_ENV=production           # 主网隐含 production
WALLET_CHAIN=mainnet            # [必填] 必须为 mainnet
# 以下在主网必须保持未设置/false，否则服务拒绝启动：
# DEV_MODE ENABLE_MOCK NEXT_PUBLIC_ENABLE_MOCK NEXT_PUBLIC_DEMO MM_TESTNET_SEED
# ADMIN_MM_SEED TESTNET_FAUCET FAUCET_ENABLED VIRTUAL_BALANCES TRADFI_VIRTUAL_INVENTORY

# ---- 核心密钥（轮换后注入）----
# [必填] 不可用默认 linbit:linbit。公网/域名主机必须 sslmode=require（或 verify-full）；
# 仅当主机是内网/容器地址（compose 服务名如 postgres、localhost、10.x/172.16-31.x/192.168.x、*.internal）时允许 sslmode=disable。
DATABASE_URL=postgres://<user>:<password>@postgres:5432/linbit?sslmode=disable
REDIS_URL=redis://:<password>@<host>:6379/0                                     # [必填] 必须带密码
JWT_SECRET=<generate: openssl rand -hex 32>                                      # [必填]
INTERNAL_TOKEN=<generate: openssl rand -hex 32>                                  # [必填]
CORS_ALLOWED_ORIGINS=https://www.cowa.click                                      # [必填]

# ---- 域名 / 代理 ----
GROWTH_INVITE_BASE_URL=https://www.cowa.click    # [必填] 必须 https
GROWTH_INTERNAL_URL=http://growth:8091           # [必填] growth 服务端口 8091
WEBAUTHN_RP_ID=www.cowa.click                    # [必填]
WEBAUTHN_RP_ORIGINS=https://www.cowa.click       # [必填]
TRUSTED_PROXY_CIDRS=<Cloudflare/LB 出口网段, 逗号分隔>   # [必填] 用于信任 CF-IPCountry

# ---- 钱包（私钥/助记词由 Yaeko 线下生成，绝不进仓库）----
# 只列出要开启的链；列出的每条链都必须有 WALLET_RPC_<NET> 与 WALLET_COLD_ADDRESS_<NET>，否则拒绝启动。
# ARBITRUM 未列出则无需任何配置。JSON 无效时主网拒绝启动（不会回退默认）。数值为示例，上线前按实际费用核对。
WALLET_NETWORKS_JSON='[
 {"asset":"USDT","network":"TRC20","confirmations":20,"minDeposit":"1","minWithdraw":"10","maxWithdraw":"100000","gasFeeEstimate":"1","gasFeeAsset":"USDT","estimatedArrivalMinutes":3},
 {"asset":"USDT","network":"ERC20","confirmations":12,"minDeposit":"10","minWithdraw":"20","maxWithdraw":"100000","gasFeeEstimate":"5","gasFeeAsset":"USDT","estimatedArrivalMinutes":5},
 {"asset":"USDT","network":"BEP20","confirmations":15,"minDeposit":"1","minWithdraw":"10","maxWithdraw":"100000","gasFeeEstimate":"0.5","gasFeeAsset":"USDT","estimatedArrivalMinutes":2},
 {"asset":"USDT","network":"SOL","confirmations":32,"minDeposit":"1","minWithdraw":"10","maxWithdraw":"100000","gasFeeEstimate":"1","gasFeeAsset":"USDT","estimatedArrivalMinutes":1},
 {"asset":"USDC","network":"ERC20","confirmations":12,"minDeposit":"10","minWithdraw":"20","maxWithdraw":"100000","gasFeeEstimate":"5","gasFeeAsset":"USDC","estimatedArrivalMinutes":5},
 {"asset":"USDC","network":"SOL","confirmations":32,"minDeposit":"1","minWithdraw":"10","maxWithdraw":"100000","gasFeeEstimate":"1","gasFeeAsset":"USDC","estimatedArrivalMinutes":1},
 {"asset":"ETH","network":"ERC20","confirmations":12,"minDeposit":"0.005","minWithdraw":"0.01","maxWithdraw":"100","gasFeeEstimate":"0.002","gasFeeAsset":"ETH","estimatedArrivalMinutes":5},
 {"asset":"BTC","network":"BTC","confirmations":2,"minDeposit":"0.0002","minWithdraw":"0.001","maxWithdraw":"10","gasFeeEstimate":"0.0002","gasFeeAsset":"BTC","estimatedArrivalMinutes":30},
 {"asset":"SOL","network":"SOL","confirmations":32,"minDeposit":"0.05","minWithdraw":"0.1","maxWithdraw":"5000","gasFeeEstimate":"0.01","gasFeeAsset":"SOL","estimatedArrivalMinutes":1}
]'
# 主网 RPC：主网绝不使用任何测试网默认 RPC。每条已开启的链必填。
WALLET_RPC_TRC20=<主网 RPC>
WALLET_TRON_API_KEY=<secret manager>
WALLET_RPC_ERC20=<主网 RPC>
WALLET_RPC_BEP20=<主网 RPC>
WALLET_RPC_BTC=<主网 RPC>
WALLET_RPC_SOL=<主网 RPC>
# WALLET_RPC_ARBITRUM=<主网 RPC>   # 仅当 WALLET_NETWORKS_JSON 开启 ARBITRUM 时
WALLET_SIGNER_URL=http://wallet-signer:<port>
WALLET_SIGNER_TOKEN=<secret manager>
# 宿主机路径（相对仓库根目录），不是容器内路径。compose 以 docker secret
# signer_passphrase 挂载到 wallet-signer 的 /run/secrets/signer_passphrase。
# 准备: install -m 0400 /dev/null secrets/signer_passphrase 后写入口令（chmod 0400）。
WALLET_SIGNER_PASSPHRASE_FILE=./secrets/signer_passphrase
WALLET_HOT_SECRET=<secret manager>     # 不可为 mock 默认值
# 冷钱包（仅地址，由 Yaeko 提供）。主网每条已开启的链必填，不再从 HD 种子派生冷地址。
WALLET_COLD_ADDRESS_TRC20=<冷钱包地址>
WALLET_COLD_ADDRESS_ERC20=<冷钱包地址>
WALLET_COLD_ADDRESS_BEP20=<冷钱包地址>
WALLET_COLD_ADDRESS_BTC=<冷钱包地址 bc1...>
WALLET_COLD_ADDRESS_SOL=<冷钱包地址>
# WALLET_COLD_ADDRESS_ARBITRUM=<冷钱包地址>   # 仅当开启 ARBITRUM
# 官方主网代币合约（格式 合约:精度）。来源见 docs/deploy/mainnet-checklist.md §4。
WALLET_TOKEN_USDT_TRC20=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t:6
WALLET_TOKEN_USDT_ERC20=0xdAC17F958D2ee523a2206206994597C13D831ec7:6
WALLET_TOKEN_USDT_BEP20=0x55d398326f99059fF775485246999027B3197955:18   # Binance-Peg USDT（非 Tether 官方发行，见清单）
WALLET_TOKEN_USDT_SOL=Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB:6
WALLET_TOKEN_USDC_ERC20=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48:6
WALLET_TOKEN_USDC_SOL=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v:6
# USDC 不支持 TRC20（Circle 已停止 TRON 上的 USDC），BEP20 无 Circle 官方 USDC —— 不要开启这两个组合。
# WALLET_TOKEN_USDC_ARBITRUM=0xaf88d065e77c8cC2239327C5EDb3A432268e5831:6   # 仅当开启 ARBITRUM（Circle 原生 USDC）
# ---- 充提风控（Yaeko 决定）----
# 充值：不设上限。
# 提现：单笔 > 1000 USDT 等值一律人工审核（主网默认；按实时 USDT 价折算，无价格则转人工）。
WALLET_RISK_AUTO_MAX_AMOUNT=1000
WALLET_RISK_REVIEW_MIN_AMOUNT=1000
WALLET_RISK_MIDDLE_ACTION=review
ADMIN_WITHDRAW_SECOND_REVIEW_USDT=5000   # 二次复核阈值

# ---- KYC 存储：本机磁盘（不用 S3/R2）----
STORAGE_BACKEND=local
KYC_DOC_STORAGE_DIR=/data/kyc-docs   # [必填] 持久卷，必须每日备份

# ---- 通知 ----
TELEGRAM_BOT_TOKEN=<secret manager>   # [必填] 偿付能力/风控告警
TELEGRAM_CHAT_ID=<chat id>            # [必填]
RESEND_API_KEY=<secret manager>       # 邮件
RESEND_FROM=Linbit <no-reply@cowa.click>
SMS_ENABLED=false                     # 不用短信；手机号注册关闭

# ---- 闪兑对冲 ----
# 主网必须显式设置且账户已存在；否则对冲停用、闪兑照常、Telegram 告警（不自动创建账户）。
CONVERT_HEDGE_USER_ID=<清空后新建的真实对冲账户，如 system:hedge-main>
# ---- 做市 / 偿付 ----
MM_ENABLED=false                      # 主网默认关闭；即便开启也只用真实充值余额
SOLVENCY_HOUR_UTC=1                   # 每日偿付能力检查(UTC)，主网必须 0-23

# ---- 功能 / 地域 ----
# 主网默认：tokenizedStocks, metals, eventContracts, chat, subAccounts, copyTrading = 开
# p2p, fiatOnRamp, options = 关（无后端）。可用 FEATURE_DEFAULTS=k=bool,... 覆盖，或后台修改。
FEATURE_DEFAULTS=
# 受限国家：默认 US,PR,GU,VI,AS,MP,UM,CU,IR,KP,SY（迁移默认，后台可改）。
# 网关全站屏蔽（451）；主网默认开启。
GEO_BLOCK_ENABLED=true
# TRADFI_RESTRICTED_COUNTRIES=        # 不设置 = 保留默认列表；仅在后台未改过时生效

# ---- 手续费：沿用测试网默认（现货 0.1%，合约 0.05%），无需设置 ----

# ---- 前端构建 ----
NEXT_PUBLIC_NETWORK=mainnet
# NEXT_PUBLIC_ENABLE_MOCK / NEXT_PUBLIC_DEMO：必须不设置（设置则构建失败）
# iOS 通行密钥/通用链接：/.well-known/apple-app-site-association（web 运行时读取；任一为空则返回 404）
APPLE_TEAM_ID=
IOS_BUNDLE_ID=
# NEXT_PUBLIC_SOCIAL_*：不设置（无社群链接）
