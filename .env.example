# Linbit backend — example environment. Copy to `.env` and fill real values.
# NEVER commit a real `.env` (it is git-ignored). Secrets here are placeholders.

# --- Environment ---
# Set to "production" on real servers. Every service then refuses to start if a
# secret is missing or still a change-me/linbit:linbit default, if REDIS_URL has
# no password, if DEV_MODE=true, if WALLET_CHAIN=mock, if CORS_ALLOWED_ORIGINS is
# empty (gateway) or if RESEND_API_KEY/RESEND_FROM are unset (account).
# An empty ADMIN_IP_ALLOWLIST only logs a WARN.
LINBIT_ENV=development

# --- Shared secrets ---
# HS256 signing key for JWT access tokens. Shared by gateway (verify) and
# account (sign). Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-secret
# Shared token guarding service-to-service /internal endpoints on the asset service.
INTERNAL_TOKEN=change-me-internal-token

# --- PostgreSQL (used by docker-compose) ---
POSTGRES_USER=linbit
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=linbit

# Connection string the services use. Host `postgres` matches the compose service.
DATABASE_URL=postgres://linbit:change-me-db-password@postgres:5432/linbit?sslmode=disable

# --- Redis ---
# Compose starts redis with --requirepass $REDIS_PASSWORD and does not publish it.
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@redis:6379

# --- Service ports ---
GATEWAY_PORT=8080
ACCOUNT_PORT=8081
ASSET_PORT=8082

# Access token lifetime in seconds (default 3600).
ACCESS_TTL_SECONDS=3600

# --- Gateway CORS ---
# Comma-separated allow-list of browser origins. Supports exact origins, a
# trailing "*" prefix wildcard (e.g. http://localhost:*), or "*" for any origin.
# Leave empty in development: the gateway then defaults to allowing
# http://localhost:* and http://127.0.0.1:* on any port. Set explicit origins in
# production. The gateway always permits the Authorization and Content-Type headers.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Gateway TradFi region gate ---
# CF-IPCountry is trusted ONLY when the gateway's direct TCP peer is inside one
# of these comma-separated CIDRs (bare IPs allowed). Empty = Cloudflare edge
# ranges (gateway reachable straight from Cloudflare). Behind nginx/Caddy on the
# same host, list the proxy's peer address instead, e.g. 127.0.0.1/32,::1/128
# or the docker bridge 172.16.0.0/12 — and make that proxy accept only
# Cloudflare and pass CF-IPCountry through. Untrusted peer / missing / XX / T1
# country => tokenized stocks & metals are refused (REGION_RESTRICTED).
TRUSTED_PROXY_CIDRS=
# Client-IP header for logs/rate limits (default X-Real-IP); access log on/off.
GATEWAY_CLIENT_IP_HEADER=
GATEWAY_ACCESS_LOG=

# --- Account: passkeys (WebAuthn) & SMS ---
# Unset WEBAUTHN_RP_ID = passkeys disabled. RP ID is the bare domain
# (e.g. example.com); origins are full https origins, comma-separated.
# The variable is WEBAUTHN_RP_ORIGINS (WEBAUTHN_ORIGINS is accepted as an alias).
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=Linbit
WEBAUTHN_RP_ORIGINS=
SMS_ENABLED=false

# --- Misc ---
# Order fee ledger account (default "platform").
FEE_ACCOUNT=
# Admin: trust X-Forwarded-For for the client IP (only behind a trusted proxy).
ADMIN_TRUST_PROXY=
# Hot-wallet MPC secret (wallet). Required in production; never commit a value.
WALLET_HOT_SECRET=

# --- Wallet / withdraw networks (asset service) ---
# Optional JSON overriding the built-in withdrawal-network config used by
# GET /wallet/withdraw/networks. The network list is fully configurable here.
# Defaults: all USDT networks (TRC20, ERC20) share a 12 USDT minimum withdrawal.
# Shape: {"ASSET":[{"network":"TRC20",
# "minWithdraw":"12.00000000","gasFeeEstimate":"1.00000000","gasFeeAsset":"USDT",
# "estimatedArrivalMinutes":5}]}. Leave empty to use defaults.
WITHDRAW_NETWORKS_JSON=

# --- External index price (market-data) ---
# REST polling of public tickers: Binance first, OKX as backup. A quote older
# than INDEX_STALE_SECONDS counts as unavailable (futures/KYC fail closed, the
# market maker pauses). INDEX_FEED=off (local last price) is refused in production.
INDEX_FEED=binance,okx
INDEX_POLL_MS=2000
INDEX_STALE_SECONDS=10

# --- Market maker / solvency ---
MM_USER_ID=mm:main
# Scheduler tick in ms (default 500).
MM_TICK_MS=
# Virtual testnet seed (mm_testnet_seed): only when WALLET_CHAIN=mock|testnet and
# LINBIT_ENV!=production; disabled outright on mainnet/production.
MM_SEED_AMOUNT=10000000
MM_SEED_MAX=10000000
# MM base-asset seed (empty = code defaults: 1000000 USDT; BTC,ETH,SOL,... list).
MM_SEED_BASE_USDT=
MM_SEED_BASE_ASSETS=
# Convert hedging (asset). Empty = code defaults (enabled on testnet,
# user system:hedge, interval 5s, backoff 5s..300s).
CONVERT_HEDGE_ENABLED=
CONVERT_HEDGE_USER_ID=
CONVERT_HEDGE_INTERVAL_SECONDS=
CONVERT_HEDGE_BACKOFF_SECONDS=
CONVERT_HEDGE_BACKOFF_MAX_SECONDS=
# asset -> order internal URL (compose default http://order:8084).
ORDER_URL=
# Daily solvency check hour (UTC, -1 = off).
SOLVENCY_HOUR_UTC=1
# Telegram alerts (solvency shortfall, index feed down / MM paused). Keep secret.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional Telegram API base (default https://api.telegram.org).
TELEGRAM_API_URL=
