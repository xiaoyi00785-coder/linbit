# Linbit backend — example environment. Copy to `.env` and fill real values.
# NEVER commit a real `.env` (it is git-ignored). Secrets here are placeholders.

# --- Shared secrets ---
# HS256 signing key for JWT access tokens. Shared by gateway (verify) and
# account (sign). Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-secret
# Shared token guarding service-to-service /internal endpoints on the asset service.
INTERNAL_TOKEN=change-me-internal-token

# --- PostgreSQL (used by docker-compose) ---
POSTGRES_USER=linbit
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=linbit

# Connection string the services use. Host `postgres` matches the compose service.
DATABASE_URL=postgres://linbit:change-me-db-password@postgres:5432/linbit?sslmode=disable

# --- Redis (optional dependency) ---
# Leave empty to run without Redis. Host `redis` matches the compose service.
REDIS_URL=redis://redis:6379

# --- Service ports ---
GATEWAY_PORT=8080
ACCOUNT_PORT=8081
ASSET_PORT=8082

# Access token lifetime in seconds (default 3600).
ACCESS_TTL_SECONDS=3600
